{
  "name": "@local/dsh-her-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persistent companion memory for DeepSeek Harness, based on her.memory's JSONL store and hybrid retrieval.",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "skills/*.md",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "for f in index.js client.js lib/*.js scripts/*.js test/*.js; do node --check \"$f\" || exit 1; done"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "memory",
    "her.memory"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
